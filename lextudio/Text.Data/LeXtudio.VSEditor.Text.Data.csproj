<Project Sdk="Microsoft.NET.Sdk">
  <!-- Builds Microsoft.VisualStudio.Text.Data from the MIT-licensed sources in
       this repository (src/Editor); see README.md for why the
       NuGet package is not used. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>Microsoft.VisualStudio.Text.Data</AssemblyName>
    <RootNamespace>Microsoft.VisualStudio.Text</RootNamespace>
    <AssemblyVersion>16.0.0.0</AssemblyVersion>
    <FileVersion>16.0.0.0</FileVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PackageId>Microsoft.VisualStudio.Text.Data</PackageId>
    <Version>17.3.198.1</Version>
    <Authors>Microsoft; LeXtudio</Authors>
    <Description>Microsoft.VisualStudio.Text.Data (17.14-compatible TextDocumentFileActionEventArgs) built from the MIT-licensed vs-editor-api sources.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/lextudio/vs-editor-api</PackageProjectUrl>
    <RepositoryUrl>https://github.com/lextudio/vs-editor-api</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
    <NoWarn>$(NoWarn);CS0618;CS1591;CS1572;CS1573;CS0649;CS0414;CS0169;CS3021;SYSLIB0003;SYSLIB0050;SYSLIB0051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\Editor\Text\Def\TextData\**\*.cs"
             Exclude="..\..\src\Editor\Text\Def\TextData\**\*AssemblyInfo.cs;..\..\src\Editor\Text\Def\TextData\**\bin\**;..\..\src\Editor\Text\Def\TextData\**\obj\**"
             LinkBase="vs-editor-api\Text\Def\TextData" />
    <!-- The upstream snapshot predates the 17.14 rename constructor and OldFilePath property;
         this local file supplies that shape. It also carries FileActionTypes, which lives in
         the same upstream file. -->
    <Compile Remove="..\..\src\Editor\Text\Def\TextData\Document\TextDocumentFileActionEventArgs.cs" />
    <Compile Include="TextDocumentFileActionEventArgs.cs" />
    <!-- Strings.Designer.cs asks the ResourceManager for "Microsoft.VisualStudio.Text.Strings". -->
    <EmbeddedResource Include="..\..\src\Editor\Text\Def\TextData\Strings.resx"
                      LogicalName="Microsoft.VisualStudio.Text.Strings.resources"
                      Link="vs-editor-api\Text\Def\TextData\Strings.resx" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <ProjectReference Include="..\CoreUtility\LeXtudio.VSEditor.CoreUtility.csproj" />
    <PackageReference Include="Microsoft.VisualStudio.Threading" />
  </ItemGroup>
</Project>
