<Project Sdk="LibreWPF.Sdk">
  <!-- Builds Microsoft.VisualStudio.Text.UI from the MIT-licensed sources in
       this repository (src/Editor); see README.md for why the
       NuGet package is not used.

       This is the one assembly of the four that uses WPF types (WindowsBase /
       PresentationCore), so it builds through LibreWPF.Sdk like OpenDevelop.VSEditorCompat,
       which references it. The WPF/Cocoa view implementations are not part of the upstream
       open-source layers and are not needed here. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Microsoft.VisualStudio.Text.UI</AssemblyName>
    <RootNamespace>Microsoft.VisualStudio.Text.Editor</RootNamespace>
    <AssemblyVersion>16.0.0.0</AssemblyVersion>
    <FileVersion>16.0.0.0</FileVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PackageId>Microsoft.VisualStudio.Text.UI</PackageId>
    <Version>17.3.198.1</Version>
    <Authors>Microsoft; LeXtudio</Authors>
    <Description>Microsoft.VisualStudio.Text.UI (LibreWPF) built from the MIT-licensed vs-editor-api sources.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/lextudio/vs-editor-api</PackageProjectUrl>
    <RepositoryUrl>https://github.com/lextudio/vs-editor-api</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
    <NoWarn>$(NoWarn);CS0618;CS1591;CS1572;CS1573;CS0649;CS0414;CS0169;CS3021;SYSLIB0003;SYSLIB0050;SYSLIB0051;NU5104</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\Editor\Text\Def\TextUI\**\*.cs"
             Exclude="..\..\src\Editor\Text\Def\TextUI\**\*AssemblyInfo.cs;..\..\src\Editor\Text\Def\TextUI\**\bin\**;..\..\src\Editor\Text\Def\TextUI\**\obj\**"
             LinkBase="vs-editor-api\Text\Def\TextUI" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <ProjectReference Include="..\CoreUtility\LeXtudio.VSEditor.CoreUtility.csproj" />
    <ProjectReference Include="..\Text.Data\LeXtudio.VSEditor.Text.Data.csproj" />
    <ProjectReference Include="..\Text.Logic\LeXtudio.VSEditor.Text.Logic.csproj" />
    <PackageReference Include="Microsoft.VisualStudio.Validation" />
    <PackageReference Include="System.ComponentModel.Composition" />
  </ItemGroup>
</Project>
